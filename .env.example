PORT=5000
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FRONTEND_URL=https://www.i-journey.org

# Recommended for hosts such as Render: base64-encode the complete
# service-account JSON file and store the result in this environment variable.
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json

# Alternative: configure all three values below instead of the base64 variable.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Number of reverse-proxy hops in front of the server (Render, Cloud Run: 1).
# The auth rate limiter counts per client address, so this must be right for it
# to tell users apart. Set to 0 when the server is reached directly.
# TRUST_PROXY=1
